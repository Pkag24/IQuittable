// Define the namespace for our code structure
namespace EmployeeApp
{
    // Declare the Employee class
    public class Employee
    {
        // Property to store the unique Employee ID number
        public int Id { get; set; }

        // Property to store the first name of the employee
        public string FirstName { get; set; }

        // Property to store the last name of the employee
        public string LastName { get; set; }

        // Overload the "==" operator to compare two Employee instances
        public static bool operator ==(Employee emp1, Employee emp2)
        {
            // Check if both objects are null or the same instance
            if (ReferenceEquals(emp1, emp2))
            {
                // Return true if both point to the same object or are null
                return true;
            }

            // Check if either object is null (but not both)
            if (emp1 is null || emp2 is null)
            {
                // Return false because one is null and the other is not
                return false;
            }

            // Compare the Id property of both employee objects
            return emp1.Id == emp2.Id;
        }

        // Overload the "!=" operator because comparison operators must be overloaded in pairs
        public static bool operator !=(Employee emp1, Employee emp2)
        {
            // Return the exact opposite of the "==" operator result
            return !(emp1 == emp2);
        }

        // Override Equals to ensure consistency with the overloaded operators
        public override bool Equals(object obj)
        {
            // Check if the incoming object is an Employee type
            if (obj is Employee otherEmployee)
            {
                // Compare IDs for equality
                return this.Id == otherEmployee.Id;
            }
            // Return false if types do not match
            return false;
        }

        // Override GetHashCode to match the Equals override
        public override int GetHashCode()
        {
            // Return hash code based on the unique Id
            return Id.GetHashCode();
        }
    }
}
