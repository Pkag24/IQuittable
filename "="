            employee1.Id = 101;

            // Assign first name to the first employee
            employee1.FirstName = "John";

            // Assign last name to the first employee
            employee1.LastName = "Doe";

            // Instantiate the second Employee object
            Employee employee2 = new Employee();

            // Assign ID value to the second employee (same ID to test equality)
            employee2.Id = 101;

            // Assign first name to the second employee (different name, same ID)
            employee2.FirstName = "Jane";

            // Assign last name to the second employee
            employee2.LastName = "Smith";

            // Compare the two Employee objects using the overloaded "==" operator
            bool areEqual = (employee1 == employee2);

            // Print the property values of the first employee
            Console.WriteLine($"Employee 1: ID = {employee1.Id}, Name = {employee1.FirstName} {employee1.LastName}");

            // Print the property values of the second employee
            Console.WriteLine($"Employee 2: ID = {employee2.Id}, Name = {employee2.FirstName} {employee2.LastName}");

            // Display the result of the equality check to the console window
            Console.WriteLine($"Are Employee 1 and Employee 2 equal based on Id? {areEqual}");
