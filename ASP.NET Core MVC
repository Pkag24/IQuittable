using System;
using System.Linq;
using Microsoft.AspNetCore.Mvc;
using YourProjectName.Models; // Change to your actual namespace

namespace YourProjectName.Controllers
{
    public class InsureeController : Controller
    {
        // Example context variable, adjust based on your project structure
        private readonly InsuranceContext _context; 

        public InsureeController(InsuranceContext context)
        {
            _context = context;
        }

        [HttpPost]
        [ValidateAntiForgeryToken]
        public IActionResult Create(Insuree insuree)
        {
            if (ModelState.IsValid)
            {
                // 1. Start with a base of $50 / month
                decimal monthlyTotal = 50m;

                // 2. Age Calculations (Calculated from Date of Birth)
                int age = DateTime.Today.Year - insuree.DateOfBirth.Year;
                if (insuree.DateOfBirth.Date > DateTime.Today.AddYears(-age)) age--;

                if (age <= 18)
                {
                    monthlyTotal += 100m;
                }
                else if (age >= 19 && age <= 25)
                {
                    monthlyTotal += 50m;
                }
                else // Covers 26 or older
                {
                    monthlyTotal += 25m;
                }

                // 3. Car Year Calculations
                if (insuree.CarYear < 2000)
                {
                    monthlyTotal += 25m;
                }
                else if (insuree.CarYear > 2015)
                {
                    monthlyTotal += 25m;
                }

                // 4. Car Make and Model Calculations
                if (insuree.CarMake?.Equals("Porsche", StringComparison.OrdinalIgnoreCase) == true)
                {
                    monthlyTotal += 25m;

                    if (insuree.CarModel?.Equals("911 Carrera", StringComparison.OrdinalIgnoreCase) == true)
                    {
                        monthlyTotal += 25m;
                    }
                }

                // 5. Speeding Tickets ($10 per ticket)
                monthlyTotal += (insuree.SpeedingTickets * 10m);

                // 6. DUI Calculation (Add 25% to the running total)
                if (insuree.HasDui)
                {
                    monthlyTotal *= 1.25m;
                }

                // 7. Full Coverage Calculation (Add 50% to the running total)
                if (insuree.IsFullCoverage)
                {
                    monthlyTotal *= 1.50m;
                }

                // Assign the final calculated total to the Insuree object
                insuree.Quote = monthlyTotal;

                _context.Add(insuree);
                _context.SaveChanges();
                return RedirectToAction(nameof(Index));
            }
            return View(insuree);
        }

        // 8. Admin View Action
        public IActionResult Admin()
        {
            // Retrieves all insurees from the database
            var insurees = _context.Insurees.ToList();
            return View(insurees);
        }
    }
}
