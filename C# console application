using System;
using System.Data.Entity;
using System.Linq;

namespace EFCodeFirstConsoleApp
{
    // 1. Define the Domain Model
    public class Student
    {
        // EF automatically recognizes "StudentID" or "Id" as the Primary Key
        public int StudentID { get; set; }
        public string FirstName { get; set; }
        public string LastName { get; set; }
        public DateTime? EnrollmentDate { get; set; }
    }

    // 2. Define the Database Context
    // The DbContext coordinates EF functionality for our data model
    public class SchoolContext : DbContext
    {
        // By default, EF creates a database named after the fully qualified context class name
        // (e.g., EFCodeFirstConsoleApp.SchoolContext) on your local .\SQLEXPRESS instance
        public SchoolContext() : base()
        {
        }

        // Each DbSet maps directly to a table in your database
        public DbSet<Student> Students { get; set; }
    }

    // 3. Application Execution
    class Program
    {
        static void Main(string[] args)
        {
            // Initialize the DbContext within a using statement to guarantee proper resource disposal
            using (var context = new SchoolContext())
            {
                Console.WriteLine("Initializing database and adding a new student...");

                // Create a new Student entity instance
                var newStudent = new Student
                {
                    FirstName = "John",
                    LastName = "Doe",
                    EnrollmentDate = DateTime.Now
                };

                // Track the entity for insertion inside the DbContext memory space
                context.Students.Add(newStudent);

                // Commit the changes to the physical SQL Server database
                // EF automatically checks if the database exists; if not, it constructs it on the fly
                context.SaveChanges();

                Console.WriteLine("Successfully saved student to the database!");
                
                // Read and verify the inserted data
                var savedStudent = context.Students.FirstOrDefault();
                if (savedStudent != null)
                {
                    Console.WriteLine($"\nSaved Student Details:\nID: {savedStudent.StudentID}\nName: {savedStudent.FirstName} {savedStudent.LastName}");
                }
            }

            Console.WriteLine("\nPress any key to exit...");
            Console.ReadKey();
        }
    }
}
